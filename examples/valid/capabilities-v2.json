{
  "schema_version": 2,
  "component": "plenora-io-tools",
  "component_version": "2.0.0",
  "interfaces": [
    {
      "kind": "rust",
      "contract": "plenora-rust-public-v1",
      "version": 1,
      "artifact": "plenora-io-core"
    },
    {
