{
  "$schema": "../../schemas/interop-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-interop-vector-v1",
  "kind": "handoff",
  "description": "Negative example: IO reads IPC and database writes it with an Arrow IPC format. database.write has the catalog sides of io.write, but its input contract selects no format and its result is JSON: the chain delivers no table and writes none as Arrow IPC (INTEROP-002).",
  "input": "../arrow-data-v1/axis-lon-lat-epsg4326.json",
  "chain": [
    {
      "component": "plenora-io-tools",
      "operation": "io.read",
      "version": 2,
      "params": {
        "source": "input.arrow",
        "format": "arrow_ipc_file"
      },
      "transformations": []
    },
    {
      "component": "plenora-database-tools",
      "operation": "database.write",
      "version": 1,
      "params": {
        "mode": "create",
        "provider": "postgresql",
        "format": "arrow_ipc_file"
      },
      "transformations": []
    }
  ],
  "expected_output": {
    "schema_metadata": {
      "plenora.contract.version": "1"
    },
    "fields": [
      {
        "name": "id",
        "type": "int64",
        "nullable": false,
        "metadata": {
          "plenora.field_id": "0"
        }
      },
      {
        "name": "geometry",
        "type": "binary",
        "nullable": true,
        "metadata": {
          "plenora.field_id": "1",
          "ARROW:extension:name": "geoarrow.wkb",
          "plenora.geometry.encoding": "wkb",
          "plenora.geometry.dimensions": "xy",
          "plenora.geometry.spatial_semantics": "geometry",
          "plenora.geometry.precision": "float64",
          "plenora.geometry.types_declaration": "exact",
          "plenora.geometry.types": "point",
          "plenora.geometry.crs_resolution": "resolved",
          "plenora.geometry.crs_id": "EPSG:4326",
          "plenora.geometry.axis_order": "lon_lat"
        }
      }
    ],
    "rows": [
      {
        "id": 1,
        "geometry": "01010000000000000000205ec00000000000a04640"
      },
      {
        "id": 2,
        "geometry": null
      }
    ]
  }
}
