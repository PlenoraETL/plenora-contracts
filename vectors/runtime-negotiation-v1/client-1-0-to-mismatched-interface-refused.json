{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A destination whose runtime interface names plenora-runtime-binding-v2 with version 1: a version that is not that of its contract, refused before sending (RT-026 item 4).",
  "sender": {
    "kind": "client",
    "requires": "plenora-runtime-binding-v1",
    "accepts_downgrade": false
  },
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v2",
      "version": 1
    }
  },
  "request": "../runtime-v1/database-read-request.json",
  "expect": {
    "decision": "refuse",
    "category": "unsupported",
    "phase": "validate",
    "remote_effect": "none",
    "retry": "never"
  }
}
