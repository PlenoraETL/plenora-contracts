{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A client requires 2.0 without downgrade; an intermediary queued only the envelope, so the second router receives from another hop the same bytes as a request of 1.0 and no negotiation context: refused before sending, never routed as 1.0 (RT-027 item 4).",
  "sender": {
    "kind": "transport",
    "requires": "plenora-runtime-binding-v2",
    "accepts_downgrade": false,
    "context": "lost"
  },
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v1",
      "version": 1
    }
  },
  "request": "../runtime-v1/database-read-request.json",
  "expect": {
    "decision": "refuse",
    "category": "unsupported",
    "phase": "validate",
    "remote_effect": "none",
    "retry": "never"
  }
}
