{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A transport routing for its sender, with the negotiation context preserved (RT-027), requires 1.0; the destination advertises 1.0: sent, governed by 1.0 (RT-026 item 1).",
  "sender": {
    "kind": "transport",
    "requires": "plenora-runtime-binding-v1",
    "accepts_downgrade": false,
    "context": "preserved"
  },
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v1",
      "version": 1
    }
  },
  "request": "../runtime-v1/database-read-request.json",
  "expect": {
    "decision": "send",
    "governed_by": "plenora-runtime-binding-v1"
  }
}
