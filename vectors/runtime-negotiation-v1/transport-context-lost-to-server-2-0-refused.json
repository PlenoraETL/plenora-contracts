{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "The negotiation context was lost on the route; the destination happens to advertise 2.0. The hop cannot know what the sender required: refused before sending (RT-027 item 4).",
  "sender": {
    "kind": "transport",
    "requires": "plenora-runtime-binding-v2",
    "accepts_downgrade": false,
    "context": "lost"
  },
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v2",
      "version": 2
    }
  },
  "request": "../runtime-v1/database-read-request.json",
  "expect": {
    "decision": "refuse",
    "category": "unsupported",
    "phase": "validate",
    "remote_effect": "none",
    "retry": "never"
  }
}
