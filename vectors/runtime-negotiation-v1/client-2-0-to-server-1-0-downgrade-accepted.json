{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A client that requires 2.0 and has declared that it accepts the downgrade, towards a destination of 1.0: sent, governed by 1.0, without RT-024 (RT-026 item 2).",
  "sender": {
    "kind": "client",
    "requires": "plenora-runtime-binding-v2",
    "accepts_downgrade": true
  },
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v1",
      "version": 1
    }
  },
  "request": "../runtime-v1/database-read-request.json",
  "expect": {
    "decision": "send",
    "governed_by": "plenora-runtime-binding-v1"
  }
}
