{
  "$schema": "../../schemas/runtime-negotiation-vector-v1.schema.json",
  "schema_version": 1,
  "contract": "plenora-runtime-negotiation-vector-v1",
  "description": "A client requires 2.0 without a declared downgrade; the destination advertises only 1.0. The request is the same bytes under both versions, so only this selection detects it: refused before sending, never downgraded implicitly (RT-026 items 2 and 3).",
  "sender": {
    "kind": "client",
    "requires": "plenora-runtime-binding-v2",
    "accepts_downgrade": false
  },
  "destination": {
    "interface": {
      "kind": "runtime",
      "contract": "plenora-runtime-binding-v1",
      "version": 1
    }
  },
  "request": "../runtime-v1/database-read-request.json",
  "expect": {
    "decision": "refuse",
    "category": "unsupported",
    "phase": "validate",
    "remote_effect": "none",
    "retry": "never"
  }
}
