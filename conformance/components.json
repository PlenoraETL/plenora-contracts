    }
  ],
  "stages": [
    {
      "id": "io",
      "component": "plenora-IO-tools",
      "status": "available",
      "invocation": [
        "cargo", "run", "--locked", "--quiet", "-p", "plenora-io-cli",
        "--", "convert", "{input}", "{output}"
      ],
      "note": "L'estensione .arrow seleziona driver-ipc su entrambi i lati: il caso attraversa lettura e riscrittura del confine file."
    },
    {
      "id": "data",
      "component": "plenora-data-tools",
      "status": "available",
      "invocation": [
        "cargo", "run", "--locked", "--quiet", "-p", "plenora-cli",
        "--", "run", "--plan", "{plan}", "--inputs", "{input}", "--output", "{output}"
      ],
      "plan_schema_version": 4
    },
    {
      "id": "database",
      "component": "plenora-database-tools",
      "status": "not_available",
      "invocation": null,
      "blocker": "plenora-database-cli non espone alcun comando che accetti un dataset Arrow IPC e riporti il contratto geometrico che ne deriverebbe. I comandi disponibili sono validate-plan, che valida un piano di scrittura e non un dataset, e postgres-probe/describe/read-summary, che richiedono un server attivo.",
      "required_capability": "Un comando offline, senza connessione, che legga Arrow IPC e produca su stdout il contratto geometrico osservato secondo plenora-database-core, incluso l'esito del parser EWKB su ogni cella. Finché non esiste, il terzo anello e' verificato solo dall'oracolo ospitato in plenora-IO-tools, che non e' terzo rispetto al primo anello."
    }
  ],
