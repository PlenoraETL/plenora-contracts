    "setup_sql": [
      "CREATE EXTENSION IF NOT EXISTS postgis",
      "CREATE SCHEMA campaign",
      "CREATE TABLE campaign.parcels (id bigint PRIMARY KEY, label text NOT NULL, assessed_value numeric(12,2), measured_at timestamptz NOT NULL, geom geometry(Point,4326) NOT NULL)",
      "INSERT INTO campaign.parcels (id, label, assessed_value, measured_at, geom) VALUES (1, 'alpha', 100.25, '2026-08-01T10:00:00Z', ST_SetSRID(ST_MakePoint(9.0, 45.0), 4326)), (2, 'beta', NULL, '2026-08-01T10:01:00Z', ST_SetSRID(ST_MakePoint(9.1, 45.1), 4326)), (3, 'gamma', 9999999999.99, '2026-08-01T10:02:00Z', ST_SetSRID(ST_MakePoint(9.2, 45.2), 4326))"
    ]
  },
