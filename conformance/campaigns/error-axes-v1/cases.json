  "degradation_cases": [
    {
      "id": "retry-quarantine-da-database-tools",
      "axis": "retry",
      "note": "Il caso reale del 2026-08-07: Database Tools emette quarantine sull'asse ritentativo, IO Tools non lo conosce. Prima di R9.16 l'intero envelope andava perso.",
      "envelope": {
        "category": "data_mapping",
        "phase": "rollback",
        "remote_effect": "unknown",
        "retry": {
          "kind": "quarantine"
        },
        "message": "vincolo violato durante il rollback"
      },
      "expected": {
        "readable": true,
        "category": "data_mapping",
        "phase": "rollback",
        "remote_effect": "unknown",
        "retry_effective": "requires_recovery",
        "retry_received": {
          "kind": "quarantine"
        }
      }
    },
    {
      "id": "retry-valore-inventato",
      "axis": "retry",
      "note": "Un valore che non esiste in nessuna versione: verifica che la degradazione non dipenda dal conoscere quarantine in particolare.",
      "envelope": {
        "category": "protocol",
        "phase": "commit",
        "remote_effect": "partial",
        "retry": {
          "kind": "after_lunar_eclipse"
        },
        "message": "risposta non interpretabile"
      },
      "expected": {
        "readable": true,
        "category": "protocol",
        "phase": "commit",
        "remote_effect": "partial",
        "retry_effective": "requires_recovery",
        "retry_received": {
          "kind": "after_lunar_eclipse"
        }
      }
    },
    {
      "id": "remote-effect-inventato",
      "axis": "remote_effect",
      "envelope": {
        "category": "timeout",
        "phase": "commit",
        "remote_effect": "half_committed",
        "retry": {
          "kind": "requires_recovery"
        },
        "message": "scadenza dopo l'invio del commit"
      },
      "expected": {
        "readable": true,
        "category": "timeout",
        "phase": "commit",
        "remote_effect_effective": "unknown",
        "remote_effect_received": "half_committed",
        "retry": "requires_recovery"
      }
    },
    {
      "id": "categoria-inventata",
      "axis": "category",
      "note": "Asse descrittivo: nessun valore conservativo, il comportamento resta governato da effetto e ritentativo.",
      "envelope": {
        "category": "quantum_decoherence",
        "phase": "read",
        "remote_effect": "none",
        "retry": {
          "kind": "never"
        },
        "message": "categoria non riconosciuta"
      },
      "expected": {
        "readable": true,
        "category_received": "quantum_decoherence",
        "category_effective": null,
        "phase": "read",
        "remote_effect": "none",
        "retry": "never"
      }
    },
    {
      "id": "fase-inventata",
      "axis": "phase",
      "envelope": {
        "category": "io",
        "phase": "defragment",
        "remote_effect": "none",
        "retry": {
          "kind": "safe"
        },
        "message": "fase non riconosciuta"
      },
      "expected": {
        "readable": true,
        "category": "io",
        "phase_received": "defragment",
        "phase_effective": null,
        "remote_effect": "none",
        "retry": "safe"
      }
    },
    {
      "id": "asse-sessione-assente",
      "axis": "session",
      "note": "R9.18: l'assenza si legge reusable, cosi' un emittente che non dichiara l'asse resta conforme.",
      "envelope": {
        "category": "conflict",
        "phase": "write",
        "remote_effect": "rolled_back",
        "retry": {
          "kind": "never"
        },
        "message": "destinazione gia' esistente"
      },
      "expected": {
        "readable": true,
        "session_effective": "reusable"
      }
    },
    {
      "id": "campo-sconosciuto",
      "axis": "envelope",
      "note": "R9.16 vale anche per i campi, non solo per i valori. Rilevato dalla prima esecuzione contro un componente reale: `deny_unknown_fields` fa rifiutare l'envelope in blocco, quindi la regola che introduce l'asse sessione sarebbe irricevibile da chi non l'ha ancora adottato.",
      "envelope": {
        "category": "schema",
        "phase": "prepare",
        "remote_effect": "none",
        "retry": {
          "kind": "never"
        },
        "campo_di_una_versione_futura": {
          "qualsiasi": "cosa"
        },
        "message": "campo non riconosciuto"
      },
      "expected": {
        "readable": true,
        "category": "schema",
        "phase": "prepare",
        "remote_effect": "none",
        "retry": "never",
        "unknown_fields_received": [
          "campo_di_una_versione_futura"
        ]
      }
    },
    {
      "id": "sessione-inventata",
      "axis": "session",
      "envelope": {
        "category": "protocol",
        "phase": "cleanup",
        "remote_effect": "unknown",
        "retry": {
          "kind": "requires_recovery"
        },
        "session": "incinerate",
        "message": "disposizione di sessione non riconosciuta"
      },
      "expected": {
        "readable": true,
        "session_received": "incinerate",
        "session_effective": "quarantine"
      }
    }
