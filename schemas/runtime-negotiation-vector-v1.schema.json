{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/runtime-negotiation-vector-v1.schema.json",
  "title": "Plenora runtime negotiation vector v1 (Runtime Binding 2.0, RT-026)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "description",
    "sender",
    "destination",
    "request",
    "expect"
  ],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "contract": {"const": "plenora-runtime-negotiation-vector-v1"},
    "description": {"type": "string", "minLength": 1, "maxLength": 512},
    "sender": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "requires", "accepts_downgrade"],
      "properties": {
        "kind": {"enum": ["client", "transport"]},
        "requires": {"enum": ["plenora-runtime-binding-v1", "plenora-runtime-binding-v2"]},
        "accepts_downgrade": {"type": "boolean"},
        "context": {
          "description": "For a transport: whether the negotiation context of the sender reached the hop that selects the destination (RT-027).",
          "enum": ["preserved", "lost"]
        }
      },
      "if": {"properties": {"kind": {"const": "transport"}}},
      "then": {"required": ["context"]},
      "else": {"not": {"required": ["context"]}}
    },
    "destination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interface"],
      "properties": {
        "interface": {
          "description": "The runtime interface of the destination's capability document (CAP-003); null when the document cannot be read.",
          "oneOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "contract", "version"],
              "properties": {
                "kind": {"const": "runtime"},
                "contract": {"type": "string", "pattern": "^plenora-[a-z0-9-]+-v[1-9][0-9]*$"},
                "version": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      }
    },
    "request": {
      "type": "string",
      "pattern": "^\\.\\./runtime-v1/[a-z0-9-]+\\.json$"
    },
    "expect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "governed_by"],
          "properties": {
            "decision": {"const": "send"},
            "governed_by": {"enum": ["plenora-runtime-binding-v1", "plenora-runtime-binding-v2"]}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["decision", "category", "phase", "remote_effect", "retry"],
          "properties": {
            "decision": {"const": "refuse"},
            "category": {"const": "unsupported"},
            "phase": {"const": "validate"},
            "remote_effect": {"const": "none"},
            "retry": {"const": "never"}
          }
        }
      ]
    }
  }
}
