{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/geoparquet-primary-vector-v1.schema.json",
  "title": "Plenora GeoParquet primary geometry vector v1",
  "description": "The correspondence of PRIM-008 between the primary geometry of an Arrow table and the `primary_column` and `columns` of GeoParquet metadata, for a writer or a reader.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "direction",
    "description",
    "table"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "plenora-geoparquet-primary-vector-v1"
    },
    "direction": {
      "description": "`write`: `table` is the input and `geo` or `expected_error` the outcome. `read`: `geo` is the file's metadata and `table` the Arrow table delivered.",
      "enum": [
        "write",
        "read"
      ]
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "table": {
      "description": "Path of an arrow-data-v1 or arrow-primary-v1 vector, relative to this file.",
      "type": "string",
      "pattern": "^\\.\\./arrow-(data|primary)-v1/[a-z0-9-]+\\.json$"
    },
    "geo": {
      "description": "The members of the GeoParquet `geo` metadata that PRIM-008 fixes; `columns` lists the keys of its `columns` object, in field order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_column",
        "columns"
      ],
      "properties": {
        "primary_column": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "expected_error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "rules"
      ],
      "properties": {
        "category": {
          "const": "unsupported"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z]+(-[A-Z]+)*-[0-9]{3}$"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "direction": {
            "const": "read"
          }
        }
      },
      "then": {
        "required": [
          "geo"
        ],
        "not": {
          "required": [
            "expected_error"
          ]
        }
      },
      "else": {
        "oneOf": [
          {
            "required": [
              "geo"
            ]
          },
          {
            "required": [
              "expected_error"
            ]
          }
        ]
      }
    }
  ]
}
