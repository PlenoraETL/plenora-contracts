{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/primary-composition-vector-v1.schema.json",
  "title": "Primary geometry field provenance vectors",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "description",
    "operation",
    "inputs",
    "mapping",
    "expected_primary",
    "expected_key"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "plenora-primary-composition-vector-v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "operation": {
      "enum": [
        "join",
        "append",
        "union"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "geometry_ids",
          "primary"
        ],
        "properties": {
          "geometry_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)$"
            }
          },
          "primary": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)$"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "mapping": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "field",
          "output"
        ],
        "properties": {
          "input": {
            "type": "integer",
            "minimum": 0
          },
          "field": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "output": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)$"
          }
        }
      }
    },
    "expected_primary": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "expected_key": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        {
          "enum": [
            "none",
            null
          ]
        }
      ]
    },
    "$schema": {
      "type": "string"
    }
  }
}
