{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.plenora.dev/file-interop-vector-v1.schema.json",
  "title": "Plenora file interop vector v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract",
    "description",
    "edge",
    "file",
    "consumer",
    "resolved",
    "expect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "contract": {
      "const": "plenora-file-interop-vector-v1"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "surface",
        "mode",
        "interchange_contract",
        "content_type",
        "format_family"
      ],
      "properties": {
        "from": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "envelope_contract",
            "artifact_form"
          ],
          "properties": {
            "operation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "operation",
                "version"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "pattern": "^plenora-[a-z][a-z0-9-]+-tools$"
                },
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "envelope_contract": {
              "type": "string",
              "pattern": "^plenora-[a-z0-9-]+-v[1-9][0-9]*$"
            },
            "artifact_form": {
              "const": "file_reference"
            }
          }
        },
        "to": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "operation",
            "envelope_contract",
            "artifact_form"
          ],
          "properties": {
            "operation": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "component",
                "operation",
                "version"
              ],
              "properties": {
                "component": {
                  "type": "string",
                  "pattern": "^plenora-[a-z][a-z0-9-]+-tools$"
                },
                "operation": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]*(\\.[a-z][a-z0-9_-]*)+$"
                },
                "version": {
                  "type": "integer",
                  "minimum": 1
                }
              }
            },
            "envelope_contract": {
              "type": "string",
              "pattern": "^plenora-[a-z0-9-]+-v[1-9][0-9]*$"
            },
            "artifact_form": {
              "const": "file_reference"
            }
          }
        },
        "surface": {
          "enum": [
            "cli",
            "runtime"
          ]
        },
        "mode": {
          "const": "direct"
        },
        "interchange_contract": {
          "const": "plenora-file-interchange-v1"
        },
        "content_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "format_family": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        }
      }
    },
    "file": {
      "$ref": "file-interchange-v1.schema.json"
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_types",
        "format_families"
      ],
      "properties": {
        "content_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
          }
        },
        "format_families": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          }
        }
      }
    },
    "resolved": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_type",
        "bytes_hex"
      ],
      "properties": {
        "content_type": {
          "type": "string",
          "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
        },
        "bytes_hex": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{2})*$"
        }
      }
    },
    "expect": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome"
          ],
          "properties": {
            "outcome": {
              "const": "accepted"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "outcome",
            "cause",
            "category",
            "phase",
            "remote_effect",
            "retry",
            "message"
          ],
          "properties": {
            "outcome": {
              "const": "error"
            },
            "cause": {
              "enum": [
                "digest_mismatch",
                "content_type_mismatch",
                "truncated_payload",
                "undeclared_format_family",
                "size_mismatch"
              ]
            },
            "category": {
              "const": "schema"
            },
            "phase": {
              "const": "validate"
            },
            "remote_effect": {
              "const": "none"
            },
            "retry": {
              "const": "never"
            },
            "message": {
              "const": "File handoff rejected."
            }
          }
        }
      ]
    }
  }
}
